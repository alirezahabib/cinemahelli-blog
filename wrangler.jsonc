{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cinemahelli-blog",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
